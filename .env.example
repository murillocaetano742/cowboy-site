# Public operational settings (safe to commit)
MELHOR_ENVIO_ENV=sandbox

# Melhor Envio: server-side only. Obtain OAuth credentials/tokens in the
# provider dashboard; never prefix these variables with NEXT_PUBLIC_.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_USER_AGENT=CowboyEnergia (suporte@seudominio.com.br)
# CEP de origem e pacote são configuração pública versionada em
# config/logistics.js: 74475-239, 23×8×8 cm, peso total 0,5 kg.

# Optional overrides for the confirmed public Cartpanda checkout links.
# Kits 1, 2 and 3 use the versioned public defaults when these are blank.
# Do not use placeholder IDs or a payment platform other than Cartpanda.
# Standard *.mycartpanda.com addresses are accepted automatically. A custom
# checkout domain must appear here as an exact comma-separated hostname.
CARTPANDA_CHECKOUT_ALLOWED_HOSTS=
CARTPANDA_CHECKOUT_1_URL=
CARTPANDA_CHECKOUT_2_URL=
CARTPANDA_CHECKOUT_3_URL=

# Server-side only: used by the CLI export of real paid orders.
# Never place this token in the public build or prefix it with NEXT_PUBLIC_.
CARTPANDA_SHOP_SLUG=cowboy-energia
CARTPANDA_API_TOKEN=
# Comma-separated order IDs with documented permission for first name + city.
# Empty means no order is approved for the public activity feed.
CARTPANDA_ACTIVITY_APPROVED_ORDER_IDS=
# Additional operational/test orders to exclude, even if provider flags say real.
CARTPANDA_ACTIVITY_EXCLUDE_ORDER_IDS=
# Confirm the API's timezone before setting an IANA name. Do not infer it from the browser.
CARTPANDA_ORDER_TIMEZONE=
